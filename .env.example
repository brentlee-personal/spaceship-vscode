# Optional browser development settings. Copy the following to .env.development.local
# and uncomment what you need. The VS Code extension uses VS Code user settings.
# VITE_CLIPROXY_MODEL=your-model-id
# CLIPROXY_ENV_FILE=/path/to/your/private/env-file
# CLIPROXY_PORT=8317
# VITE_DECISION_PROVIDER=plumb # optional, otherwise decisions use the writing LLM
# DECISIONS_SSH_HOST=your-ssh-alias
# DECISIONS_REMOTE_PORT=8102
# DECISIONS_TUNNEL_PORT=18102

# Optional upstream prompt-engineering scripts.
CEREBRAS_DEV_API_KEY=your_api_key_here
GEMINI_API=your_api_key_here
