{
  "name": "spaceship-writer",
  "displayName": "Spaceship 中文写作台",
  "description": "在 VS Code 中编辑稿件，用多个独立旋钮引导中文续写，并写回原文件或选区。",
  "version": "0.1.0",
  "publisher": "brentlee-personal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brentlee-personal/spaceship-vscode.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "连接配置取自用户设置，仅处理通过命令明确打开的稿件。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "spaceship.open",
        "title": "打开写作台",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.openFile",
        "title": "在写作台打开文件",
        "category": "Spaceship",
        "icon": "$(edit)"
      },
      {
        "command": "spaceship.fromSelection",
        "title": "用选区续写",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.newDraft",
        "title": "新建 Markdown 稿件",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.setKey",
        "title": "设置 CLIProxyAPI 密钥",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.settings",
        "category": "Spaceship",
        "title": "配置模型连接"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spaceship.openFile",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^(\\.md|\\.markdown|\\.txt)$/i",
          "group": "navigation@20"
        },
        {
          "command": "spaceship.newDraft",
          "when": "explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "spaceship.fromSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "spaceship.openFile",
          "when": "editorLangId == markdown || editorLangId == plaintext",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "Spaceship 中文写作台",
      "properties": {
        "spaceship.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "CLIProxyAPI 上提供的续写模型。"
        },
        "spaceship.proxyPort": {
          "type": "number",
          "default": 8317,
          "scope": "machine",
          "description": "本机 CLIProxyAPI 监听端口。",
          "minimum": 1,
          "maximum": 65535
        },
        "spaceship.keyFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "可选的本机 dotenv 凭据文件路径，读取 CLIPROXY_API_KEY。"
        },
        "spaceship.decisionsSshHost": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "可选的 SSH 配置别名。留空时使用本机 Decisions 服务。"
        },
        "spaceship.decisionsPort": {
          "type": "number",
          "default": 8102,
          "scope": "machine",
          "description": "Decisions 服务在目标主机回环地址上的端口。",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/brentlee-personal/spaceship-vscode/issues"
  },
  "homepage": "https://github.com/brentlee-personal/spaceship-vscode",
  "keywords": [
    "writing",
    "markdown",
    "steering",
    "中文",
    "creative writing"
  ]
}
