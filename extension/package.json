{
  "name": "spaceship-writer",
  "displayName": "Spaceship Writer",
  "description": "Steer your writing in VS Code with independent controls, then apply it to your Markdown file or selection.",
  "version": "0.2.0",
  "publisher": "brentlee-personal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brentlee-personal/spaceship-vscode.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Uses user-level connection settings and only manuscripts explicitly opened through a command."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "spaceship.open",
        "title": "Open Writing Desk",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.openFile",
        "title": "Open File in Writing Desk",
        "category": "Spaceship",
        "icon": "$(edit)"
      },
      {
        "command": "spaceship.fromSelection",
        "title": "Continue from Selection",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.newDraft",
        "title": "New Markdown Draft",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.setKey",
        "title": "Set CLIProxyAPI Key",
        "category": "Spaceship"
      },
      {
        "command": "spaceship.settings",
        "category": "Spaceship",
        "title": "Configure Model Connection"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spaceship.openFile",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^(\\.md|\\.markdown|\\.txt)$/i",
          "group": "navigation@20"
        },
        {
          "command": "spaceship.newDraft",
          "when": "explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "spaceship.fromSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "spaceship.openFile",
          "when": "editorLangId == markdown || editorLangId == plaintext",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "Spaceship Writer",
      "properties": {
        "spaceship.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Continuation model provided by CLIProxyAPI."
        },
        "spaceship.proxyPort": {
          "type": "number",
          "default": 8317,
          "scope": "machine",
          "description": "Local CLIProxyAPI listening port.",
          "minimum": 1,
          "maximum": 65535
        },
        "spaceship.keyFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional local dotenv file containing CLIPROXY_API_KEY."
        },
        "spaceship.decisionsSshHost": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional SSH configuration alias. Leave empty to use the local Decisions service."
        },
        "spaceship.decisionsPort": {
          "type": "number",
          "default": 8102,
          "scope": "machine",
          "description": "Decisions service port on the target host loopback address.",
          "minimum": 1,
          "maximum": 65535
        },
        "spaceship.decisionProvider": {
          "type": "string",
          "enum": [
            "llm",
            "plumb"
          ],
          "default": "llm",
          "scope": "machine",
          "description": "Use the writing LLM for decisions (default), or try the configured Plumb service with automatic LLM fallback."
        },
        "spaceship.decisionModel": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional decision model available through the same local CLIProxyAPI gateway. Empty uses spaceship.model. Never changes the writing model."
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/brentlee-personal/spaceship-vscode/issues"
  },
  "homepage": "https://github.com/brentlee-personal/spaceship-vscode",
  "keywords": [
    "writing",
    "markdown",
    "steering",
    "multilingual",
    "creative writing"
  ]
}
