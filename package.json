{
  "name": "handstorm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "build:extension": "tsc && vite build --base ./ --outDir extension/media --emptyOutDir",
    "package:extension": "npm run build:extension && cd extension && vsce package --no-dependencies",
    "community:check": "node scripts/community-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:extension-host": "node tests/extension-host/run.mjs",
    "test:installed-extension": "node tests/extension-host/installed-run.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.1.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  }
}
